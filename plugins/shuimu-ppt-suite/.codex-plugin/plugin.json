    "defaultPrompt": "\u4f7f\u7528 $shuimu-ppt\uff0c\u628a\u6211\u7684\u81ea\u7136\u8bed\u8a00\u9700\u6c42\u6574\u7406\u6210\u5b8c\u6574\u9010\u9875\u8bbe\u8ba1\u6587\u6863\uff0c\u518d\u6309\u6211\u7684\u4ea4\u4ed8\u8303\u56f4\u3001\u7f16\u8f91\u6027\u548c\u6a21\u677f\u8981\u6c42\u9009\u62e9\u5236\u4f5c\u6d41\u7a0b\u3002"
